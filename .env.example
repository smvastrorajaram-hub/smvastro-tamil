NODE_ENV=production
ADMIN_UID=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ADMIN_EMAIL=
RESEND_API_KEY=
RESEND_FROM=
ALLOWED_ORIGINS=

SWISSEPH_EPHE_PATH=./ephe
HOUSE_SYSTEM=S

# Optional AI future interpretation (server-side only; never expose this key in index.html)
GEMINI_API_KEY=
AI_RATE_LIMIT_MAX=10
AI_RATE_LIMIT_WINDOW_MS=600000

# Registration phone policy
# Default/free mode: email verification + one-phone-one-account.
# Set to whatsapp only after a WhatsApp OTP provider is integrated/configured.
PHONE_VERIFICATION_MODE=email_unique
WHATSAPP_OTP_PROVIDER=
